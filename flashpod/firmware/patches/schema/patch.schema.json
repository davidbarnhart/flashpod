{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "ipod-patches format 3 patch (patch.json)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "id",
  "author",
  "title",
  "base",
  "requires",
  "conflicts",
  "status",
  "edits",
  "append",
  "copies",
  "source",
  "license"
 ],
 "properties": {
  "format": {
   "const": 3
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "author": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string"
  },
  "base": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "requires": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9.-]*$"
   }
  },
  "conflicts": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9.-]*$"
   }
  },
  "status": {
   "enum": [
    "released",
    "testing",
    "withdrawn",
    "test"
   ]
  },
  "edits": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "image",
     "offset",
     "patched",
     "check"
    ],
    "properties": {
     "image": {
      "type": "string",
      "pattern": "^[a-z]{4}$"
     },
     "offset": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "vaddr": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "patched": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})+$"
     },
     "why": {
      "type": "string"
     },
     "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "offset",
       "bytes",
       "sha256"
      ],
      "properties": {
       "offset": {
        "type": "string",
        "pattern": "^0x[0-9a-f]+$"
       },
       "bytes": {
        "type": "integer",
        "minimum": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   }
  },
  "append": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "image",
     "offset",
     "bytes",
     "sha256",
     "file"
    ],
    "properties": {
     "image": {
      "type": "string",
      "pattern": "^[a-z]{4}$"
     },
     "offset": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "vaddr": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "bytes": {
      "type": "integer",
      "minimum": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
     }
    }
   }
  },
  "copies": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "image",
     "offset",
     "from"
    ],
    "properties": {
     "image": {
      "type": "string",
      "pattern": "^[a-z]{4}$"
     },
     "offset": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "image",
       "offset",
       "bytes",
       "sha256"
      ],
      "properties": {
       "image": {
        "type": "string",
        "pattern": "^[a-z]{4}$"
       },
       "offset": {
        "type": "string",
        "pattern": "^0x[0-9a-f]+$"
       },
       "bytes": {
        "type": "integer",
        "minimum": 16
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   }
  },
  "source": {
   "type": "object"
  },
  "license": {
   "type": "string"
  }
 }
}
