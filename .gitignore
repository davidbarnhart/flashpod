# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Packaging / build output (setuptools, PyInstaller)
/build/
/dist/

# Firmware images dropped in for a "heavy" (self-contained) build — they live
# on the firmware release, not in the repo
/flashpod/firmware/*.ipsw
/flashpod/firmware/*.bin.gz

# Compiled libgpod oracle (build from ipodctl.c when needed)
/ipodctl

# Local Claude Code project instructions (not for the public repo)
/CLAUDE.md

# Hand-built release tarballs passing through (the 10.8 build gets scp'd
# here on its way to `gh release upload`)
/flashpod-macos-*.tar.gz

# Editor / OS junk
*.swp
.DS_Store
._*
